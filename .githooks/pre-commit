#!/bin/sh
# Check the commit without changing any file. Build and format by hand with `make build` and `make format`.
set -e
cd "$(git rev-parse --show-toplevel)"

if [ ! -x node_modules/.bin/eslint ]; then
  echo "pre-commit: dev tools are missing; run 'make install'." >&2
  exit 1
fi

make --no-print-directory check
