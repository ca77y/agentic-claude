# OS state
.DS_Store

# Story worktrees
.worktrees/

# Local workflow state and scratch, including the delivery ledger, at the root of each checkout or worktree
/.tmp/

# Preserve ignore protection for existing scratch files
/tmp/

# Python bytecode from hook scripts
__pycache__/
*.pyc

# Plugin eval reports
plugins/*/evals/results/

# Development tooling
node_modules/

# Obsidian local/generated state
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Obsidian community plugin code, installed per machine through Obsidian
.obsidian/plugins/

# Terraform local state and provider cache
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan

# SWE-bench Pro comparison: pinned task folders, images' repositories, runs, and reports
/.eval/
